rules_version = '2';

// Alpha LPG: security rules shared by the customer, rider and admin apps.
//
// Staff are recognised from documents, so this works on the free Firebase plan:
//   admins/{uid}  created by hand in the console for the owner
//   riders/{uid}  created by the owner; `active: false` blocks a rider
// (Custom claims { admin: true } / { rider: true } also work.)
//
// Prices are checked HERE, against products/* and config/app, so a modified
// app cannot change what an order costs. That means products and config/app
// must exist before anyone can order (run `npm run seed` or use the admin app).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is calling -----------------------------------------------------

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function isAdmin() {
      return signedIn() && (request.auth.token.get('admin', false) == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // The owner can do everything. Staff admins (admins/{uid}.role == 'staff')
    // cannot change settings, delete products, cancel paid orders, or manage
    // other admins.
    function isOwner() {
      return signedIn() && (request.auth.token.get('admin', false) == true
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'owner') == 'owner'));
    }
    function isRider() {
      return signedIn() && (request.auth.token.get('rider', false) == true
        || (exists(/databases/$(database)/documents/riders/$(request.auth.uid))
            && get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.get('active', true) == true));
    }
    function riderProfile() {
      return get(/databases/$(database)/documents/riders/$(request.auth.uid)).data;
    }

    // Phone sign-in puts the verified number in the token; data that names a
    // phone number must match it, so nobody can order "as" another number.
    function phoneMatchesToken(phone) {
      return ('phone_number' in request.auth.token)
        ? phone == request.auth.token.phone_number
        // "Quick sign-in" customers have no verified number: it must at least
        // be a well-formed Pakistani mobile, and the shop confirms by phone.
        : phone.matches('^\\+923[0-9]{9}$');
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isText(v, max) { return v is string && v.size() <= max; }
    function isNum(v) { return v is int || v is float; }

    // ---- Catalogue and business settings (public read, admin write) ---------

    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isOwner();
    }
    match /config/{doc} {
      allow read: if true;
      allow create, delete: if isOwner();
      // Staff may only open or close the shop (and its closed message).
      allow update: if isOwner()
        || (isAdmin() && changed().hasOnly(['acceptingOrders', 'closedMessage']));
    }

    // ---- Customers the shop has blocked ---------------------------------------

    match /blocked/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'reason', 'at'])
        && isText(request.resource.data.get('reason', ''), 200)
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---- Customers and their saved locations --------------------------------

    match /customers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'phone', 'type', 'businessName', 'businessType', 'email', 'fcmToken', 'createdAt', 'updatedAt'])
        && isText(request.resource.data.name, 79)
        && request.resource.data.name.size() > 1
        && request.resource.data.type in ['home', 'business']
        && isText(request.resource.data.get('phone', ''), 20)
        && phoneMatchesToken(request.resource.data.get('phone', ''))
        && isText(request.resource.data.get('businessName', ''), 80)
        && isText(request.resource.data.get('businessType', ''), 40)
        && isText(request.resource.data.get('email', ''), 100)
        && isText(request.resource.data.get('fcmToken', ''), 300);
      // Customers can delete their own account data (orders are kept).
      allow delete: if isSelf(uid) || isAdmin();

      match /addresses/{id} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(
               ['label', 'line1', 'area', 'landmark', 'city', 'lat', 'lng', 'createdAt'])
          && isText(request.resource.data.label, 20)
          && isText(request.resource.data.line1, 160)
          && isText(request.resource.data.area, 80)
          && isText(request.resource.data.get('landmark', ''), 160)
          && isText(request.resource.data.get('city', 'Lahore'), 40)
          && (request.resource.data.get('lat', null) == null
              || (isNum(request.resource.data.lat) && request.resource.data.lat >= 31.2 && request.resource.data.lat <= 31.8))
          && (request.resource.data.get('lng', null) == null
              || (isNum(request.resource.data.lng) && request.resource.data.lng >= 74.05 && request.resource.data.lng <= 74.7));
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // ---- Orders -------------------------------------------------------------

    // One order line is valid when it names an active, in-stock product at
    // exactly the price in the catalogue. Index i beyond the list is fine.
    function lineValid(it) {
      let p = get(/databases/$(database)/documents/products/$(it.productId)).data;
      return it.quantity is int && it.quantity >= 1 && it.quantity <= 99
        && it.unitPrice is int
        && p.get('active', true) == true
        && p.get('inStock', true) == true
        && it.unitPrice == (it.type == 'newCylinder'
             ? p.get('newCylinderPrice', null)
             : p.get('refillPrice', null));
    }
    function lineOk(items, i) { return items.size() <= i || lineValid(items[i]); }
    function lineSum(items, i) { return items.size() <= i ? 0 : items[i].unitPrice * items[i].quantity; }

    function feeFor(subtotal, s, area) {
      return (subtotal == 0
              || (s.get('freeDeliveryFrom', 0) > 0 && subtotal >= s.get('freeDeliveryFrom', 0)))
        ? 0
        : s.get('areaFees', {}).get(area.trim().lower(), s.get('deliveryFee', 0));
    }

    // (Size checks use .size() directly; a wrongly typed value fails the rule.)
    function addressOk(a) {
      return a.keys().hasOnly(['label', 'line1', 'area', 'landmark', 'city', 'lat', 'lng'])
        && a.get('line1', '').size() <= 160
        && a.get('area', '').size() <= 80
        && a.get('landmark', '').size() <= 160
        && a.get('label', '').size() <= 20;
    }

    function validNewOrder() {
      let d = request.resource.data;
      let s = get(/databases/$(database)/documents/config/app).data;
      let items = d.items;
      return d.keys().hasOnly([
            'orderNumber', 'customerId', 'customerName', 'customerPhone', 'customerType', 'businessName',
            'items', 'subtotal', 'deliveryFee', 'total', 'address', 'paymentMethod', 'paymentStatus',
            'paymentReference', 'status', 'history', 'scheduledFor', 'notes', 'riderId', 'riderName',
            'riderPhone', 'cancelReason', 'rating', 'feedback', 'cashCollected', 'emptiesCollected',
            'cylinderCount', 'emptiesToCollect', 'couponCode', 'couponDiscount', 'pointsUsed',
            'pointsDiscount', 'discount', 'createdAt', 'updatedAt'])
        && d.customerId == request.auth.uid
        && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid))
        && d.customerName.size() <= 80
        && phoneMatchesToken(d.customerPhone)
        && d.customerType in ['home', 'business']
        && d.status == 'placed'
        && d.paymentStatus == 'pending'
        && d.paymentMethod in ['cashOnDelivery', 'jazzCash', 'easyPaisa', 'bankTransfer']
        && d.get('paymentReference', '').size() <= 40
        && d.get('notes', '').size() <= 500
        && d.get('businessName', '').size() <= 80
        // Nothing a rider or the shop fills in later can be pre-filled.
        && d.get('riderId', null) == null && d.get('riderName', null) == null
        && d.get('riderPhone', null) == null && d.get('rating', null) == null
        && d.get('cashCollected', null) == null && d.get('emptiesCollected', null) == null
        && d.get('cancelReason', '') == ''
        && d.history.size() == 1
        && d.createdAt == request.time && d.updatedAt == request.time
        && addressOk(d.address)
        // Prices and totals must match the catalogue and shop settings.
        // At most 6 lines (a Firestore rule may run at most 1000 steps).
        && items.size() >= 1 && items.size() <= 6
        && lineOk(items, 0) && lineOk(items, 1) && lineOk(items, 2)
        && lineOk(items, 3) && lineOk(items, 4) && lineOk(items, 5)
        && d.subtotal == lineSum(items, 0) + lineSum(items, 1) + lineSum(items, 2)
                       + lineSum(items, 3) + lineSum(items, 4) + lineSum(items, 5)
        && d.deliveryFee == feeFor(d.subtotal, s, d.address.get('area', ''))
        && d.total == d.subtotal + d.deliveryFee - d.get('discount', 0)
        && d.total >= 0
        && (!d.keys().hasAny(['discount', 'couponCode', 'couponDiscount', 'pointsUsed', 'pointsDiscount'])
            || discountOk(d, s))
        && s.get('acceptingOrders', true) == true
        && d.subtotal >= s.get('minOrderTotal', 0);
    }

    // ---- Discounts: a shop code, a friend's code, reward points -----------------

    // Rupees a shop coupon takes off this subtotal.
    function couponAmount(c, sub) {
      let raw = c.get('type', 'amount') == 'percent' ? sub * c.value / 100 : c.value;
      let capped = (c.get('maxDiscount', 0) > 0 && raw > c.maxDiscount) ? c.maxDiscount : raw;
      return capped > sub ? sub : capped;
    }

    function shopCouponOk(d, code, cd) {
      let c = get(/databases/$(database)/documents/coupons/$(code)).data;
      return c.get('active', true) == true
        && (c.get('expiresAt', null) == null || c.expiresAt > request.time)
        && d.subtotal >= c.get('minOrder', 0)
        && cd <= couponAmount(c, d.subtotal)
        && existsAfter(/databases/$(database)/documents/coupons/$(code)/uses/$(request.auth.uid));
    }

    // A friend's invite code: it must be a real one, not the customer's own.
    function friendCodeOk(d, s, code, cd) {
      return exists(/databases/$(database)/documents/referralCodes/$(code))
        && get(/databases/$(database)/documents/referralCodes/$(code)).data.uid != request.auth.uid
        && cd <= s.get('referralDiscount', 200)
        && cd <= d.subtotal
        && existsAfter(/databases/$(database)/documents/referralUses/$(request.auth.uid));
    }

    function pointsOk(d, s, pu, pd, cd) {
      return pu == 0
        || (get(/databases/$(database)/documents/loyalty/$(request.auth.uid)).data.get('points', 0) >= pu
            && pd <= d.subtotal * s.get('maxPointsPercent', 30) / 100
            && pd + cd <= d.subtotal);
    }

    function discountOk(d, s) {
      let cd = d.get('couponDiscount', 0);
      let pu = d.get('pointsUsed', 0);
      let pd = d.get('pointsDiscount', 0);
      let code = d.get('couponCode', '');
      return cd is int && pu is int && pd is int && cd >= 0 && pu >= 0 && pd >= 0
        && d.get('discount', 0) == cd + pd
        && pd == pu * s.get('pointValue', 1)
        && (code == ''
            ? cd == 0
            : (code.size() <= 30
               && (code.matches('REF-.*') ? friendCodeOk(d, s, code, cd) : shopCouponOk(d, code, cd))))
        && pointsOk(d, s, pu, pd, cd);
    }

    // The history list may only grow by one entry per status change.
    function historyGrowsByOne() {
      return request.resource.data.history is list
        && request.resource.data.history.size() == resource.data.history.size() + 1;
    }

    match /orders/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isRider() && resource.data.riderId == request.auth.uid)
        // Riders may see jobs nobody has taken yet.
        || (isRider() && resource.data.riderId == null
            && resource.data.status in ['placed', 'confirmed']);

      allow create: if signedIn() && validNewOrder();

      allow update: if (isAdmin()
            && (isOwner()
                || !(request.resource.data.status == 'cancelled' && resource.data.paymentStatus == 'paid'))
            // Once the rider is on the way the order stays with them: it can
            // not be taken back or given to someone else.
            && (resource.data.status != 'outForDelivery'
                || request.resource.data.get('riderId', null) == resource.data.get('riderId', null))
            // A new rider can only be given an order while they are on shift.
            && (request.resource.data.get('riderId', null) == null
                || request.resource.data.get('riderId', null) == resource.data.get('riderId', null)
                || (exists(/databases/$(database)/documents/riders/$(request.resource.data.riderId))
                    && get(/databases/$(database)/documents/riders/$(request.resource.data.riderId)).data.get('online', false) == true
                    && get(/databases/$(database)/documents/riders/$(request.resource.data.riderId)).data.get('active', true) == true)))
        // Customer cancels while the order is still "placed".
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'placed'
            && request.resource.data.status == 'cancelled'
            && isText(request.resource.data.cancelReason, 200)
            && historyGrowsByOne()
            && changed().hasOnly(['status', 'history', 'cancelReason', 'updatedAt']))
        // Customer adds the transaction ID of a prepaid order.
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.paymentStatus == 'pending'
            && resource.data.paymentMethod != 'cashOnDelivery'
            && resource.data.status != 'cancelled'
            && isText(request.resource.data.paymentReference, 40)
            && changed().hasOnly(['paymentReference', 'updatedAt']))
        // Customer uploads a payment receipt for a prepaid, unpaid order.
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.paymentStatus == 'pending'
            && resource.data.paymentMethod != 'cashOnDelivery'
            && resource.data.status != 'cancelled'
            && request.resource.data.receiptAt == request.time
            && request.resource.data.get('paymentIssue', '') == ''
            && changed().hasOnly(['receiptAt', 'paymentIssue', 'paymentReference', 'paidAmount', 'updatedAt'])
            && (!changed().hasAny(['paymentReference'])
                || (isText(request.resource.data.paymentReference, 40)
                    && request.resource.data.paymentReference.size() >= 4))
            && (!changed().hasAny(['paidAmount'])
                || (request.resource.data.paidAmount is int
                    && request.resource.data.paidAmount > 0
                    && request.resource.data.paidAmount <= 5000000)))
        // Customer rates a delivered order once.
        || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'delivered'
            && resource.data.get('rating', null) == null
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && isText(request.resource.data.get('feedback', ''), 500)
            && changed().hasOnly(['rating', 'feedback', 'updatedAt']))
        // An online rider takes an untaken order (first come, first served),
        // under their own name from their rider record.
        || (isRider()
            && riderProfile().get('online', false) == true
            && resource.data.riderId == null
            && resource.data.status in ['placed', 'confirmed']
            && request.resource.data.riderId == request.auth.uid
            && request.resource.data.riderName == riderProfile().name
            && request.resource.data.riderPhone == riderProfile().get('phone', '')
            && request.resource.data.status == 'assigned'
            && historyGrowsByOne()
            && changed().hasOnly(['riderId', 'riderName', 'riderPhone', 'status', 'history', 'updatedAt']))
        // The assigned rider sets off ...
        || (isRider()
            && resource.data.riderId == request.auth.uid
            && resource.data.status == 'assigned'
            && request.resource.data.status == 'outForDelivery'
            && historyGrowsByOne()
            && changed().hasOnly(['status', 'history', 'updatedAt']))
        // The rider taps "I've arrived" once the order is on the way.
        || (isRider()
            && resource.data.riderId == request.auth.uid
            && resource.data.status == 'outForDelivery'
            && resource.data.get('arrivedAt', null) == null
            && request.resource.data.arrivedAt == request.time
            && changed().hasOnly(['arrivedAt', 'updatedAt']))
        // A rider who cannot do an assigned job hands it back to the shop.
        || (isRider()
            && resource.data.riderId == request.auth.uid
            && resource.data.status == 'assigned'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.riderId == null
            && request.resource.data.riderName == null
            && request.resource.data.riderPhone == null
            && historyGrowsByOne()
            && changed().hasOnly(['riderId', 'riderName', 'riderPhone', 'status', 'history', 'updatedAt']))
        // ... and completes it, recording cash taken and empties collected.
        // Cash can only mark a cash-on-delivery order as paid.
        || (isRider()
            && resource.data.riderId == request.auth.uid
            && resource.data.status == 'outForDelivery'
            && request.resource.data.status == 'delivered'
            && (resource.data.paymentMethod == 'cashOnDelivery' || resource.data.paymentStatus == 'paid')
            && historyGrowsByOne()
            && request.resource.data.cashCollected is int
            && request.resource.data.cashCollected >= 0
            && request.resource.data.cashCollected <= 2000000
            && request.resource.data.emptiesCollected is int
            && request.resource.data.emptiesCollected >= 0
            && request.resource.data.emptiesCollected <= 99
            && changed().hasOnly(['status', 'history', 'paymentStatus', 'cashCollected', 'emptiesCollected', 'updatedAt'])
            && (!changed().hasAny(['paymentStatus'])
                || (resource.data.paymentMethod == 'cashOnDelivery'
                    && request.resource.data.paymentStatus == 'paid')));

      allow delete: if false;

      // Order chat: the customer, the assigned rider and the shop.
      match /messages/{mid} {
        function orderDoc() {
          return get(/databases/$(database)/documents/orders/$(id)).data;
        }
        allow read: if isAdmin()
          || (signedIn() && orderDoc().customerId == request.auth.uid)
          || (isRider() && orderDoc().riderId == request.auth.uid);
        // Chat is only open while the order is: once it is delivered or
        // cancelled nobody can write to it any more.
        allow create: if request.resource.data.keys().hasOnly(['uid', 'role', 'name', 'text', 'createdAt'])
          && orderDoc().status in ['placed', 'confirmed', 'assigned', 'outForDelivery']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && isText(request.resource.data.name, 80)
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.role == 'customer' && signedIn() && orderDoc().customerId == request.auth.uid)
            || (request.resource.data.role == 'rider' && isRider() && orderDoc().riderId == request.auth.uid)
            || (request.resource.data.role == 'admin' && isAdmin())
          );
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Payment receipts (photos) the customer sends for the shop to check.
      match /receipts/{rid} {
        function orderDoc() {
          return get(/databases/$(database)/documents/orders/$(id)).data;
        }
        allow read: if isAdmin()
          || (signedIn() && orderDoc().customerId == request.auth.uid);
        allow create: if signedIn()
          && orderDoc().customerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'data', 'note', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() > 100
          && request.resource.data.data.size() <= 450000
          && isText(request.resource.data.get('note', ''), 200)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // "Seen" and unread counts: when each side last opened the chat.
      match /reads/{who} {
        function orderDoc() {
          return get(/databases/$(database)/documents/orders/$(id)).data;
        }
        allow read: if isAdmin()
          || (signedIn() && orderDoc().customerId == request.auth.uid)
          || (isRider() && orderDoc().riderId == request.auth.uid);
        allow create, update: if request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && (
            (who == 'customer' && signedIn() && orderDoc().customerId == request.auth.uid)
            || (who == 'rider' && isRider() && orderDoc().riderId == request.auth.uid)
            || (who == 'admin' && isAdmin())
          );
        allow delete: if isAdmin();
      }

      // The rider's live position while delivering.
      match /live/{doc} {
        function orderDoc() {
          return get(/databases/$(database)/documents/orders/$(id)).data;
        }
        allow create, update: if isRider()
          && orderDoc().riderId == request.auth.uid
          && orderDoc().status == 'outForDelivery'
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'heading', 'speedKmh', 'accuracy', 'updatedAt'])
          && isNum(request.resource.data.lat) && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && isNum(request.resource.data.lng) && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.updatedAt == request.time;
        allow read: if isAdmin()
          || (signedIn() && orderDoc().customerId == request.auth.uid)
          || (isRider() && orderDoc().riderId == request.auth.uid);
        allow delete: if isAdmin();
      }

      // Photo of the delivery (taken by the rider at the door).
      match /proofs/{pid} {
        function proofOrder() {
          return get(/databases/$(database)/documents/orders/$(id)).data;
        }
        allow read: if isAdmin()
          || (signedIn() && proofOrder().customerId == request.auth.uid)
          || (isRider() && proofOrder().riderId == request.auth.uid);
        allow create: if isRider()
          && proofOrder().riderId == request.auth.uid
          && proofOrder().status in ['outForDelivery', 'delivered']
          && request.resource.data.keys().hasOnly(['uid', 'data', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() >= 100
          && request.resource.data.data.size() <= 450000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---- Bulk / commercial quote requests (guests may submit too) -----------

    match /quoteRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['customerId', 'businessName', 'contactName', 'phone', 'businessType', 'monthlyKg',
             'preferredSize', 'area', 'notes', 'status', 'createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && isText(request.resource.data.phone, 20)
        && isText(request.resource.data.businessName, 100)
        && isText(request.resource.data.contactName, 80)
        && isText(request.resource.data.get('businessType', ''), 60)
        && isText(request.resource.data.get('preferredSize', ''), 30)
        && isText(request.resource.data.get('area', ''), 80)
        && isText(request.resource.data.get('notes', ''), 1000)
        && request.resource.data.get('monthlyKg', 0) is int
        && (request.resource.data.customerId == ''
            || (signedIn() && request.resource.data.customerId == request.auth.uid));
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- Coupons, invite codes, reward points, plans ---------------------------

    function cancelledOwnOrder(orderId) {
      let o = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return o.customerId == request.auth.uid && o.status == 'cancelled';
    }

    // A code can be looked up by its exact name, never listed.
    match /coupons/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();

      // One use per customer, spent together with the order.
      match /uses/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['orderId', 'at'])
          && request.resource.data.at == request.time;
        allow delete: if isAdmin()
          || (signedIn() && request.auth.uid == uid && cancelledOwnOrder(resource.data.orderId));
      }
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn()
        && code.matches('REF-[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }

    // "This customer already used a friend's code" (once only).
    match /referralUses/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['orderId', 'at'])
        && request.resource.data.at == request.time;
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == uid && cancelledOwnOrder(resource.data.orderId));
    }

    // Reward points: only the shop's app changes them.
    match /loyalty/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
      match /entries/{id} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if isAdmin();
      }
    }

    // Public rating numbers for the home screen.
    match /stats/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A customer's repeat-order plan.
    match /plans/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lines', 'everyDays', 'paymentMethod', 'nextDue', 'active'])
        && request.resource.data.lines is list
        && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 6
        && request.resource.data.everyDays is int
        && request.resource.data.everyDays >= 7 && request.resource.data.everyDays <= 90
        && request.resource.data.paymentMethod in ['cashOnDelivery', 'jazzCash', 'easyPaisa', 'bankTransfer']
        && request.resource.data.active is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Riders --------------------------------------------------------------

    // Admin managed. A rider reads their own record and may only flip their
    // on-shift switch.
    match /riders/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid)
            && changed().hasOnly(['online', 'lastSeen', 'lat', 'lng'])
            && request.resource.data.online is bool
            && (!changed().hasAny(['lat'])
                || (isNum(request.resource.data.lat) && request.resource.data.lat >= 31.0 && request.resource.data.lat <= 32.0))
            && (!changed().hasAny(['lng'])
                || (isNum(request.resource.data.lng) && request.resource.data.lng >= 73.8 && request.resource.data.lng <= 74.9)));
    }

    // "Is this rider on shift?" Public and free of personal details: the
    // customer app counts live riders. A rider writes only their own record;
    // the shop can switch anyone off.
    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (isRider() && isSelf(uid)
            && request.resource.data.keys().hasOnly(['online', 'lastSeen'])
            && request.resource.data.online is bool
            && request.resource.data.lastSeen == request.time);
      allow delete: if isAdmin();
    }

    // Owners: listed by hand in the console. Nobody can write from the apps.
    match /admins/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt'])
        && request.resource.data.role in ['owner', 'staff']
        && isText(request.resource.data.get('email', ''), 100)
        && isText(request.resource.data.get('name', ''), 80);
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // ---- Customer reports about an order or its rider (straight to the shop) --

    match /reports/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isRider() && resource.data.get('by', 'customer') == 'rider'
            && resource.data.riderId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'orderId', 'orderNumber', 'customerId', 'customerName', 'customerPhone',
             'riderId', 'riderName', 'about', 'by', 'reason', 'details', 'status', 'reply', 'createdAt'])
        && request.resource.data.about in ['order', 'rider']
        && request.resource.data.get('by', 'customer') in ['customer', 'rider']
        && isText(request.resource.data.reason, 80)
        && request.resource.data.reason.size() > 0
        && isText(request.resource.data.details, 600)
        && isText(request.resource.data.orderNumber, 40)
        && isText(request.resource.data.customerName, 80)
        && isText(request.resource.data.customerPhone, 20)
        && request.resource.data.status == 'open'
        && request.resource.data.reply == ''
        && request.resource.data.createdAt == request.time
        && (
          // A customer reports their own order.
          (request.resource.data.get('by', 'customer') == 'customer'
            && request.resource.data.customerId == request.auth.uid
            && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid)
          // A rider reports a problem on a delivery that is theirs.
          || (request.resource.data.by == 'rider'
            && isRider()
            && request.resource.data.customerId == ''
            && request.resource.data.riderId == request.auth.uid
            && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.riderId == request.auth.uid)
        );
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'resolvedAt', 'refund'])
        && request.resource.data.status in ['open', 'resolved']
        && request.resource.data.get('refund', 'none') in ['none', 'refunded', 'declined']
        && isText(request.resource.data.reply, 600);
      allow delete: if isOwner();
    }

    // Riders' public star rating (worked out by the shop from customer ratings).
    match /riderStats/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['average', 'count'])
        && isNum(request.resource.data.average)
        && request.resource.data.average >= 0 && request.resource.data.average <= 5
        && request.resource.data.count is int;
    }

    // ---- Shop operations (admin only) -----------------------------------------

    // Customer cylinder / deposit account.
    match /ledger/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'kind', 'amount', 'empties', 'note', 'by', 'at'])
        && request.resource.data.kind in ['deposit', 'depositRefund', 'emptiesOwed', 'emptiesReturned']
        && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 5000000
        && request.resource.data.empties is int && request.resource.data.empties >= 0 && request.resource.data.empties <= 999
        && isText(request.resource.data.customerId, 128)
        && isText(request.resource.data.customerName, 80)
        && isText(request.resource.data.note, 200)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Cash a rider handed in.
    match /handovers/{id} {
      allow read: if isAdmin() || (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['riderId', 'riderName', 'amount', 'note', 'by', 'at'])
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 5000000
        && isText(request.resource.data.riderId, 128)
        && isText(request.resource.data.riderName, 80)
        && isText(request.resource.data.note, 200)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Who did what. Only the owner can read it; nobody can change or erase it.
    match /audit/{id} {
      allow read: if isOwner();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'byName', 'action', 'target', 'detail', 'at'])
        && request.resource.data.by == request.auth.uid
        && isText(request.resource.data.byName, 80)
        && isText(request.resource.data.action, 60)
        && isText(request.resource.data.target, 128)
        && isText(request.resource.data.detail, 300)
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Crash and error reports from the apps.
    match /errors/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['app', 'version', 'uid', 'message', 'stack', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.app in ['customer', 'rider', 'admin']
        && isText(request.resource.data.version, 30)
        && isText(request.resource.data.message, 500)
        && isText(request.resource.data.stack, 2000)
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Server-only counters (order numbers).
    match /counters/{doc} {
      allow read, write: if false;
    }
  }
}
