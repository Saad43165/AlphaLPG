{
  "name": "alpha-lpg-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test lib/pricing.test.js",
    "deploy": "firebase deploy --only functions",
    "seed": "tsc && node lib/tools/seed.js",
    "set-role": "tsc && node lib/tools/set-role.js",
    "add-rider": "tsc && node lib/tools/add-rider.js",
    "add-admin": "tsc && node lib/tools/add-admin.js",
    "test:rules": "cd .. && npx firebase-tools emulators:exec --only firestore --project demo-alpha \"cd functions && node --test test/rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.19.0",
    "firebase": "^12.19.0",
    "typescript": "^5.9.3"
  }
}
